{
  "name": "hon-forge",
  "version": "0.1.0",
  "private": true,
  "description": "Forge LED wall: four live, interactive Honeywell web dashboards laid out on one large LED wall, with click-to-activate fullscreen. Electron + WebContentsView.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "mock": "node src/dev/mock-server.js",
    "dev": "FORGE_DEV=1 FORGE_CONFIG=./config/local-dev.json node src/dev/dev.js",
    "test": "node --test test/config.test.js test/layout.test.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "probe": "electron src/dev/probe.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0"
  },
  "license": "UNLICENSED"
}

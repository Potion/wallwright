{
  "name": "hon-forge",
  "productName": "Forge",
  "version": "0.2.0",
  "private": true,
  "description": "Forge LED wall: four live, interactive Honeywell web dashboards laid out on one large LED wall, with click-to-activate fullscreen. Electron + WebContentsView.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "mock": "node src/dev/mock-server.js",
    "dev": "node src/dev/dev.js",
    "test": "node --test test/config.test.js test/layout.test.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "probe": "electron src/dev/probe.js",
    "probe:fs": "node src/dev/fsprobe-all.js",
    "icon": "node src/dev/make-icon.js",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:mac:dir": "electron-builder --mac --dir --publish never",
    "capture": "electron src/dev/capture.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0"
  },
  "license": "UNLICENSED"
}

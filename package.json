{
  "name": "wallwright",
  "productName": "Wallwright",
  "productName": "Wallwright",
  "version": "0.1.2",
  "private": true,
  "author": "Jeff Crouse <jeff.crouse@hyperquake.com>",
  "description": "Wallwright: a montage of live, interactive web pages laid out on one large LED wall, arrangeable at the wall itself. Electron + WebContentsView.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "mock": "node src/dev/mock-server.js",
    "dev": "node src/dev/dev.js",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "probe": "electron src/dev/probe.js",
    "probe:fs": "node src/dev/fsprobe-all.js",
    "icon": "node src/dev/make-icon.js",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:mac:dir": "electron-builder --mac --dir --publish never",
    "capture": "node src/dev/capture.js",
    "probe:session": "node src/dev/session-probe-run.js",
    "probe:activity": "node src/dev/activity-probe-run.js",
    "probe:perm": "node src/dev/probe-serve.js perm-probe.js",
    "probe:nav": "node src/dev/probe-serve.js nav-probe.js",
    "coverage": "node --test --experimental-test-coverage --test-coverage-lines=97 --test-coverage-branches=87 --test-coverage-functions=95 \"test/**/*.test.js\"",
    "selftest": "node src/dev/selftest-run.js",
    "check:asar": "node src/dev/asar-check.js",
    "soak": "node src/dev/soak.js",
    "stream-cost": "node src/dev/stream-cost.js",
    "report": "node src/dev/reports.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.0.0",
    "js-yaml": "^4.3.2",
    "prettier": "^3.0.0"
  },
  "license": "UNLICENSED"
}
